# =============================================================================
# LAN gateway — password-gated Archon Web UI on your local network.
# Used by the `lan` compose profile. Listens on :8080 inside the container;
# LAN_BIND/LAN_PORT in .env decide which host address that maps to.
# =============================================================================
{
	# No Let's Encrypt on a LAN: there is no public DNS name to validate.
	auto_https off
	admin off
}

:8080 {
	# ── Never reachable from the network ──────────────────────────────────────
	# /internal/git-credential hands out live GitHub App installation tokens.
	# Blocking it here is what makes ARCHON_ALLOW_INTERNAL_ON_PUBLIC_BIND=1 safe
	# when you run Archon in GitHub App mode.
	handle /internal/* {
		respond "Not Found" 404
	}

	# ── Unauthenticated by design ─────────────────────────────────────────────
	# Health check for monitoring; webhooks authenticate via HMAC signature.
	handle /api/health {
		reverse_proxy app:{$PORT:3000}
	}
	handle /webhooks/* {
		reverse_proxy app:{$PORT:3000}
	}

	# ── Password gate ─────────────────────────────────────────────────────────
	# Generated by `./archon password '<password>'`. Ships empty (no auth).
	import /etc/caddy/auth.conf

	# ── Everything else ───────────────────────────────────────────────────────
	handle {
		# Archon streams agent output over SSE; buffering would stall the UI.
		@sse path /api/stream/*
		reverse_proxy @sse app:{$PORT:3000} {
			flush_interval -1
		}
		reverse_proxy app:{$PORT:3000}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode gzip zstd

	log {
		output stdout
		format console
	}
}
