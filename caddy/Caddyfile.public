# =============================================================================
# Public gateway — Archon on a real domain with automatic Let's Encrypt TLS.
# Used by the `public` compose profile. Requires DOMAIN in .env, a DNS A record
# pointing at this machine, and inbound ports 80 + 443 open.
# =============================================================================
{
	admin off
}

{$DOMAIN} {
	# See Caddyfile.lan for why /internal/* is blocked outright.
	handle /internal/* {
		respond "Not Found" 404
	}

	handle /api/health {
		reverse_proxy app:{$PORT:3000}
	}
	handle /webhooks/* {
		reverse_proxy app:{$PORT:3000}
	}

	# Generated by `./archon password '<password>'`.
	# STRONGLY recommended before exposing Archon to the internet — anyone who
	# reaches the UI can run arbitrary code through your AI agent.
	import /etc/caddy/auth.conf

	handle {
		@sse path /api/stream/*
		reverse_proxy @sse app:{$PORT:3000} {
			flush_interval -1
		}
		reverse_proxy app:{$PORT:3000}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	encode gzip zstd

	log {
		output stdout
		format console
	}
}
