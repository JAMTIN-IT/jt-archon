# =============================================================================
# Archon Portable - configuration
# =============================================================================
# Copy to `.env` (or run `./archon init`, which does it for you) and edit.
#
#  !! Compose interpolates this file. A literal $ must be written as $$.     !!
#     That is why the Web UI password lives in caddy/auth.conf instead -
#     use `./archon password <password>`, never paste a hash in here.
#
# Every variable Archon itself understands also works here. This file is the
# curated subset that actually matters for a portable Docker install; the full
# upstream list is at https://github.com/coleam00/Archon/blob/main/.env.example
# =============================================================================


# -----------------------------------------------------------------------------
# 1. MODE - who can reach the Web UI
# -----------------------------------------------------------------------------
# local   Only this machine, at http://localhost:3000. Safest. Default.
# lan     Your LAN IP behind a password, e.g. http://192.168.1.50:8080.
#         Run `./archon password <password>` first.
# public  A real domain with automatic HTTPS. Requires DOMAIN below, a DNS A
#         record, and ports 80/443 reachable. Set a password first.
#
# Append `,db` to also run PostgreSQL (e.g. `lan,db`) - see section 6.
COMPOSE_PROFILES=local


# -----------------------------------------------------------------------------
# 2. CLAUDE - required, this is what actually does the work
# -----------------------------------------------------------------------------
# Claude Code ships inside the Archon image; you only supply credentials.
#
# A containerised Archon CANNOT reuse your host's `claude /login` session
# (CLAUDE_USE_GLOBAL_AUTH=true does nothing here - there is no interactive
# claude CLI inside the container). Give it one of the two below instead.
#
# RECOMMENDED - billed to your Claude subscription:
#     claude setup-token          (run on this machine, paste the result)
# or just run:
#     ./archon auth claude        (runs it and writes the token here for you)
CLAUDE_CODE_OAUTH_TOKEN=

# ALTERNATIVE - metered API billing, from console.anthropic.com/settings/keys.
# Only used when the OAuth token above is empty.
# CLAUDE_API_KEY=

# Which assistant new conversations default to: claude | codex | copilot | pi
DEFAULT_AI_ASSISTANT=claude

# Cheap model for auto-generating conversation titles.
# TITLE_GENERATION_MODEL=claude-haiku-4-5


# -----------------------------------------------------------------------------
# 3. NETWORK - ports and addresses
# -----------------------------------------------------------------------------
# Port Archon listens on inside the container, and the port published on this
# machine for local access. Change it if 3000 is already taken.
PORT=3000

# Which host address the Archon port itself is published on.
# Leave this as 127.0.0.1. In lan/public mode Caddy is the door teammates use;
# setting this to 0.0.0.0 would put an UNAUTHENTICATED Archon on the network.
ARCHON_APP_BIND=127.0.0.1

# --- lan mode ----------------------------------------------------------------
# Host address the LAN gateway binds to. 0.0.0.0 = every interface (keeps
# working when DHCP moves you). Pin it to one fixed address for a stable,
# static entry point, e.g. LAN_BIND=192.168.1.50 - reserve that IP in your
# router first so it cannot change.
LAN_BIND=0.0.0.0
LAN_PORT=8080

# --- public mode -------------------------------------------------------------
# Your domain. Its DNS A record must point at this machine's public IP.
# DOMAIN=archon.example.com


# -----------------------------------------------------------------------------
# 3b. LOCAL CODE - the folder that holds the repos you want Archon to work on
# -----------------------------------------------------------------------------
# Archon runs inside a container and resolves every codebase path there, so a
# host path typed into the Web UI ("C:\DEV-KC\kc-agents", "/Users/me/code/app")
# cannot be found. Mount the PARENT folder of your repos here instead:
#
#   Windows    PROJECTS_DIR=C:/DEV-KC          (forward slashes)
#   macOS      PROJECTS_DIR=/Users/you/code
#   Linux      PROJECTS_DIR=/home/you/code
#
# Everything under it then appears at /projects/<name> inside the container,
# and THAT is what you type when adding a codebase:
#
#   host   C:/DEV-KC/kc-agents   ->   Web UI   /projects/kc-agents
#
# `./archon path <host-path>` prints the translation for you.
# Unset, this falls back to a ./projects folder inside this repo.
PROJECTS_DIR=

# -----------------------------------------------------------------------------
# 4. GITHUB - repos, bot identity, and who is allowed to drive it
# -----------------------------------------------------------------------------
# Pick ONE of the two modes. Archon refuses to start if both are configured.

# --- PAT mode (simple, single identity - start here) -------------------------
# A token with `repo` scope. Both names are read; keep them identical.
# `./archon auth github` fills these in from your existing `gh` login.
GH_TOKEN=
GITHUB_TOKEN=

# WHO MAY DRIVE ARCHON. Comma-separated GitHub usernames, case-insensitive.
# Only these users can trigger workflows from GitHub issues, PRs and comments.
# AN EMPTY VALUE MEANS EVERY GITHUB USER IS ALLOWED - always set it.
#   GITHUB_ALLOWED_USERS=octocat,hubot,my-teammate
GITHUB_ALLOWED_USERS=

# Shared secret for GitHub webhook signature verification. Generate one with
# `./archon secret` and paste the same value into the repo's webhook settings.
WEBHOOK_SECRET=

# The @name Archon answers to in issues and PRs. Falls back to BOT_DISPLAY_NAME.
# GITHUB_BOT_MENTION=archon
# BOT_DISPLAY_NAME=Archon

# --- GitHub App mode (multi-user teams; leave PAT mode blank if you use it) ---
# Full walkthrough: https://docs.archon.diy/adapters/github-app-setup
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/.archon/github-app.pem
# GITHUB_APP_SLUG=archon
# GITHUB_APP_CLIENT_ID=
# TOKEN_ENCRYPTION_KEY=                 # 64 hex chars - `./archon secret hex`
#
# REQUIRED IN APP MODE with this stack. Archon refuses to start in App mode on
# a non-loopback bind, because /internal/git-credential hands out live tokens.
# Both Caddyfiles in caddy/ return 404 for /internal/*, so that endpoint is not
# reachable from the network here and this opt-in is sound.
# ARCHON_ALLOW_INTERNAL_ON_PUBLIC_BIND=1


# -----------------------------------------------------------------------------
# 5. CHAT PLATFORMS - optional, drive Archon from where your team already is
# -----------------------------------------------------------------------------
# Same rule as GitHub: an empty allow-list means ANYONE in the workspace.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USER_IDS=
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USER_IDS=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=


# -----------------------------------------------------------------------------
# 5b. MCP SERVERS - credentials for the configs in mcp/
# -----------------------------------------------------------------------------
# These are read at NODE RUN TIME, not at startup: a node that declares
#   mcp: /opt/archon-mcp/figma-remote.json
# gets the $VAR references inside that file's `headers`/`env` expanded from the
# container's environment. Change a value here and `./archon restart` to apply.
#
# Verify any of them for real - handshake plus a live tool list - with:
#   ./archon mcp figma-remote      (or figma-desktop, supabase, github)
#
# FIGMA - https://www.figma.com/developers/api#access-tokens
# Settings -> Security -> Personal access tokens -> Generate new token.
# Give it at least these scopes, all read-only:
#   File content: Read only        (get_design_context, get_variable_defs)
#   Dev resources: Read only       (Code Connect mapping)
#   Library content: Read only     (search_design_system, get_libraries)
# Note the header is X-Figma-Token, NOT `Authorization: Bearer` - Figma's server
# rejects figd_ tokens sent as a bearer token. mcp/figma-remote.json handles it.
# FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# The desktop config (mcp/figma-desktop.json) needs no token - it talks to the
# Figma Desktop app on this machine over host.docker.internal:3845. It also
# needs that app to be running with Dev Mode's MCP server switched on.
#
# SUPABASE - https://supabase.com/dashboard/account/tokens
# A personal access token (sbp_...). Use the config as:
#   mcp: /opt/archon-mcp/supabase.local.json
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Pin the agent to ONE project. Strongly recommended: without it the token's
# whole account is in reach and the agent can enumerate every project you own.
# Find the ref in the dashboard URL: /dashboard/project/<this-part>
# SUPABASE_PROJECT_REF=
#
# read_only=true is the default and makes every query run as a read-only
# Postgres role. Set this to false only if you want the agent to write.
# SUPABASE_READ_ONLY=false
#
# Both of the above are rendered into mcp/supabase.local.json (gitignored) by
# ./archon up and ./archon restart, because Archon expands $VAR only inside an
# MCP config's `headers` and `env` - never inside `url`, where these two live.
# The TOKEN is not written to that file; it stays a $VAR in `headers`.
# Editing supabase.local.json by hand is pointless - it is overwritten.


# -----------------------------------------------------------------------------
# 6. DATABASE - SQLite by default, nothing to do
# -----------------------------------------------------------------------------
# Switch to PostgreSQL only for heavy parallel use (20+ concurrent workflows).
# Add `db` to COMPOSE_PROFILES above AND uncomment this line - the hostname is
# the compose service name, not localhost:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/remote_coding_agent
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# 7. STORAGE - where Archon keeps workspaces, clones and history
# -----------------------------------------------------------------------------
# Unset (default): Docker-managed named volumes. Portable, survives rebuilds,
# and sidesteps every file-ownership problem. Recommended on Windows and macOS.
#
# Set these to absolute HOST paths only if you want the data browsable. On
# Linux the paths must be owned by UID 1001 (`sudo chown -R 1001:1001 <path>`);
# on macOS they cannot be, which is what ARCHON_ALLOW_ROOT_FALLBACK is for.
# ARCHON_DATA=/opt/archon-data
# ARCHON_USER_HOME=/opt/archon-user-home

# macOS ONLY, and only together with the bind mounts above: Docker's VirtioFS
# refuses to remap host ownership to the container user, so the container exits
# on start. This keeps it running as root instead. Do NOT set this on Linux -
# there the same failure means the paths really are chowned wrong; fix those.
# ARCHON_ALLOW_ROOT_FALLBACK=1


# -----------------------------------------------------------------------------
# 8. IMAGE + RUNTIME
# -----------------------------------------------------------------------------
# Pin a version so the whole team runs the same build (e.g. 0.9.0), or track
# `latest`. `./archon update` pulls whatever this points at.
ARCHON_VERSION=latest
# ARCHON_IMAGE=ghcr.io/coleam00/archon
# ARCHON_PULL_POLICY=missing            # `always` to re-check on every up

MAX_CONCURRENT_CONVERSATIONS=10
LOG_LEVEL=info
# SESSION_RETENTION_DAYS=30

# Archon reports anonymous usage counters to its maintainers. Uncomment to opt
# out. The upstream .env.example lists exactly what is and is not collected.
# ARCHON_TELEMETRY_DISABLED=1
